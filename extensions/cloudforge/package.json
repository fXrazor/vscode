{
	"name": "cloudforge",
	"displayName": "%displayName%",
	"description": "%description%",
	"version": "0.0.1",
	"publisher": "cloudforge",
	"license": "MIT",
	"engines": {
		"vscode": "^1.74.0"
	},
	"main": "./dist/extension.js",
	"extensionKind": [
		"ui"
	],
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": true
		},
		"virtualWorkspaces": true
	},
	"contributes": {
		"languages": [
			{
				"id": "terraform",
				"extensions": [
					".tf",
					".tfvars",
					".tofu",
					".tftest.hcl"
				],
				"aliases": [
					"Terraform",
					"OpenTofu",
					"terraform",
					"hcl"
				],
				"configuration": "./terraform.language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "terraform",
				"scopeName": "source.hcl.terraform",
				"path": "./syntaxes/terraform.tmLanguage.json"
			}
		],
		"configuration": {
			"title": "%displayName%",
			"properties": {
				"cloudforge.editor.codeLens": {
					"type": "boolean",
					"default": true,
					"description": "%config.editor.codeLens%"
				},
				"cloudforge.projects.openInNewWindow": {
					"type": "string",
					"enum": [
						"ask",
						"newWindow",
						"currentWindow"
					],
					"default": "ask",
					"description": "%config.projects.openInNewWindow%"
				}
			}
		},
		"commands": [
			{
				"command": "cloudforge.showProofStatus",
				"title": "%command.showProofStatus%",
				"category": "%displayName%"
			},
			{
				"command": "cloudforge.openWorkspace",
				"title": "%command.openWorkspace%",
				"category": "%displayName%"
			},
			{
				"command": "cloudforge.cloneRepository",
				"title": "%command.cloneRepository%",
				"category": "%displayName%",
				"icon": "$(repo-clone)"
			},
			{
				"command": "cloudforge.createProject",
				"title": "%command.createProject%",
				"category": "%displayName%",
				"icon": "$(new-folder)"
			},
			{
				"command": "cloudforge.openProjectInNewWindow",
				"title": "%command.openProjectInNewWindow%",
				"category": "%displayName%",
				"icon": "$(window)"
			},
			{
				"command": "cloudforge.createArchitecture",
				"title": "%command.createArchitecture%",
				"category": "%displayName%",
				"icon": "$(add)"
			},
			{
				"command": "cloudforge.switchArchitecture",
				"title": "%command.switchArchitecture%",
				"category": "%displayName%",
				"icon": "$(arrow-swap)"
			},
			{
				"command": "cloudforge.applyWorkspacePreset",
				"title": "%command.applyWorkspacePreset%",
				"category": "%displayName%",
				"icon": "$(layout)"
			},
			{
				"command": "cloudforge.importRepository",
				"title": "%command.importRepository%",
				"category": "%displayName%",
				"icon": "$(cloud-download)"
			},
			{
				"command": "cloudforge.refreshProject",
				"title": "%command.refreshProject%",
				"category": "%displayName%",
				"icon": "$(refresh)"
			},
			{
				"command": "cloudforge.forgetProjectAccess",
				"title": "%command.forgetProjectAccess%",
				"category": "%displayName%"
			},
			{
				"command": "cloudforge.resetIgnoredImports",
				"title": "%command.resetIgnoredImports%",
				"category": "%displayName%"
			},
			{
				"command": "cloudforge.installGit",
				"title": "%command.installGit%",
				"category": "%displayName%"
			},
			{
				"command": "cloudforge.openArchitecture",
				"title": "%command.openArchitecture%",
				"category": "%displayName%"
			},
			{
				"command": "cloudforge.openArchitectureCanvas",
				"title": "%command.openArchitectureCanvas%",
				"category": "%displayName%",
				"icon": "$(type-hierarchy)"
			},
			{
				"command": "cloudforge.openArchitectureFocus",
				"title": "%command.openArchitectureFocus%",
				"category": "%displayName%",
				"icon": "$(screen-full)"
			},
			{
				"command": "cloudforge.validateProjectArchitecture",
				"title": "%command.validateProjectArchitecture%",
				"category": "%displayName%",
				"icon": "$(check-all)"
			},
			{
				"command": "cloudforge.planProjectArchitecture",
				"title": "%command.planProjectArchitecture%",
				"category": "%displayName%",
				"icon": "$(diff)"
			},
			{
				"command": "cloudforge.revealArchitectureFolder",
				"title": "%command.revealArchitectureFolder%",
				"category": "%displayName%",
				"icon": "$(folder-opened)"
			},
			{
				"command": "cloudforge.revealRepositoryFolder",
				"title": "%command.revealRepositoryFolder%",
				"category": "%displayName%",
				"icon": "$(folder-opened)"
			},
			{
				"command": "cloudforge.reattachRepository",
				"title": "%command.reattachRepository%",
				"category": "%displayName%",
				"icon": "$(root-folder-opened)"
			},
			{
				"command": "cloudforge.removeRepository",
				"title": "%command.removeRepository%",
				"category": "%displayName%",
				"icon": "$(close)"
			},
			{
				"command": "cloudforge.cloneRepositoryAgain",
				"title": "%command.cloneRepositoryAgain%",
				"category": "%displayName%",
				"icon": "$(repo-clone)"
			},
			{
				"command": "cloudforge.openCanvas",
				"title": "%command.openCanvas%",
				"category": "%displayName%",
				"icon": "$(type-hierarchy)"
			},
			{
				"command": "cloudforge.toggleCanvasFocusMode",
				"title": "%command.toggleCanvasFocusMode%",
				"category": "%displayName%",
				"icon": "$(screen-full)"
			},
			{
				"command": "cloudforge.validateArchitecture",
				"title": "%command.validateArchitecture%",
				"category": "%displayName%",
				"icon": "$(check-all)"
			},
			{
				"command": "cloudforge.runEnginePlan",
				"title": "%command.runEnginePlan%",
				"category": "%displayName%",
				"icon": "$(diff)"
			},
			{
				"command": "cloudforge.cancelValidation",
				"title": "%command.cancelValidation%",
				"category": "%displayName%",
				"icon": "$(debug-stop)"
			},
			{
				"command": "cloudforge.exportCanvas",
				"title": "%command.exportCanvas%",
				"category": "%displayName%",
				"icon": "$(export)"
			},
			{
				"command": "cloudforge.exportMultiTarget",
				"title": "%command.exportMultiTarget%",
				"category": "%displayName%",
				"icon": "$(file-code)"
			},
			{
				"command": "cloudforge.inspectArchitectureReadiness",
				"title": "%command.inspectArchitectureReadiness%",
				"category": "%displayName%",
				"icon": "$(shield)"
			},
			{
				"command": "cloudforge.diffProviderSchema",
				"title": "%command.diffProviderSchema%",
				"category": "%displayName%",
				"icon": "$(versions)"
			},
			{
				"command": "cloudforge.explainResource",
				"title": "%command.explainResource%",
				"category": "%displayName%",
				"icon": "$(lightbulb)"
			},
			{
				"command": "cloudforge.revealNodeInCanvas",
				"title": "%command.revealNodeInCanvas%",
				"category": "%displayName%",
				"icon": "$(type-hierarchy)"
			},
			{
				"command": "cloudforge.importProviderSchema",
				"title": "%command.importProviderSchema%",
				"category": "%displayName%",
				"icon": "$(cloud-upload)"
			},
			{
				"command": "cloudforge.extractMirrorSchema",
				"title": "%command.extractMirrorSchema%",
				"category": "%displayName%",
				"icon": "$(package)"
			},
			{
				"command": "cloudforge.importMirrorPackage",
				"title": "%command.importMirrorPackage%",
				"category": "%displayName%",
				"icon": "$(archive)"
			},
			{
				"command": "cloudforge.evictMirrorPackage",
				"title": "%command.evictMirrorPackage%",
				"category": "%displayName%",
				"icon": "$(trash)"
			},
			{
				"command": "cloudforge.verifyMirrorIntegrity",
				"title": "%command.verifyMirrorIntegrity%",
				"category": "%displayName%",
				"icon": "$(verified)"
			},
			{
				"command": "cloudforge.planMirrorCleanup",
				"title": "%command.planMirrorCleanup%",
				"category": "%displayName%",
				"icon": "$(clear-all)"
			},
			{
				"command": "cloudforge.initArchitectureOffline",
				"title": "%command.initArchitectureOffline%",
				"category": "%displayName%",
				"icon": "$(plug)"
			},
			{
				"command": "cloudforge.openTemplateLibrary",
				"title": "%command.openTemplateLibrary%",
				"category": "%displayName%",
				"icon": "$(library)"
			},
			{
				"command": "cloudforge.openProjectGallery",
				"title": "%command.openProjectGallery%",
				"category": "%displayName%",
				"icon": "$(layout)"
			},
			{
				"command": "cloudforge.openProjectStatus",
				"title": "%command.openProjectStatus%",
				"category": "%displayName%",
				"icon": "$(dashboard)"
			},
			{
				"command": "cloudforge.refreshSidePanel",
				"title": "%command.refreshSidePanel%",
				"category": "%displayName%",
				"icon": "$(refresh)"
			},
			{
				"command": "cloudforge.linkCloudConnection",
				"title": "%command.linkCloudConnection%",
				"category": "%displayName%",
				"icon": "$(plug)"
			},
			{
				"command": "cloudforge.storeCloudKey",
				"title": "%command.storeCloudKey%",
				"category": "%displayName%",
				"icon": "$(key)"
			},
			{
				"command": "cloudforge.deleteCloudKey",
				"title": "%command.deleteCloudKey%",
				"category": "%displayName%",
				"icon": "$(trash)"
			},
			{
				"command": "cloudforge.removeCloudConnection",
				"title": "%command.removeCloudConnection%",
				"category": "%displayName%",
				"icon": "$(debug-disconnect)"
			},
			{
				"command": "cloudforge.checkCloudSignIn",
				"title": "%command.checkCloudSignIn%",
				"category": "%displayName%",
				"icon": "$(verified)"
			},
			{
				"command": "cloudforge.revealStateResource",
				"title": "%command.revealStateResource%",
				"category": "%displayName%"
			}
		],
		"keybindings": [
			{
				"command": "cloudforge.toggleCanvasFocusMode",
				"key": "ctrl+alt+f",
				"mac": "cmd+alt+f"
			},
			{
				"command": "cloudforge.switchArchitecture",
				"key": "ctrl+alt+a",
				"mac": "cmd+alt+a",
				"when": "cloudforge.projectOpen"
			},
			{
				"command": "cloudforge.applyWorkspacePreset",
				"key": "ctrl+alt+l",
				"mac": "cmd+alt+l"
			},
			{
				"command": "cloudforge.runEnginePlan",
				"key": "ctrl+alt+p",
				"mac": "cmd+alt+p"
			}
		],
		"views": {
			"explorer": [
				{
					"id": "cloudforge.projects",
					"name": "%view.projects%"
				},
				{
					"id": "cloudforge.resources",
					"name": "%view.resources%"
				}
			],
			"cloudforge": [
				{
					"id": "cloudforge.status",
					"name": "%view.status%",
					"icon": "$(dashboard)"
				},
				{
					"id": "cloudforge.panel.projects",
					"name": "%view.projects%"
				},
				{
					"id": "cloudforge.panel.resources",
					"name": "%view.resources%"
				},
				{
					"id": "cloudforge.state",
					"name": "%view.state%",
					"visibility": "collapsed"
				},
				{
					"id": "cloudforge.connections",
					"name": "%view.connections%"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "cloudforge.resources",
				"contents": "%view.resources.welcome%"
			},
			{
				"view": "cloudforge.panel.resources",
				"contents": "%view.resources.welcome%"
			},
			{
				"view": "cloudforge.projects",
				"contents": "%view.projects.welcome%",
				"when": "!cloudforge.projectOpen"
			},
			{
				"view": "cloudforge.panel.projects",
				"contents": "%view.projects.welcome%",
				"when": "!cloudforge.projectOpen"
			},
			{
				"view": "cloudforge.projects",
				"contents": "%view.projects.emptyProject%",
				"when": "cloudforge.projectOpen"
			},
			{
				"view": "cloudforge.panel.projects",
				"contents": "%view.projects.emptyProject%",
				"when": "cloudforge.projectOpen"
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "cloudforge.openArchitecture",
					"when": "false"
				},
				{
					"command": "cloudforge.openArchitectureCanvas",
					"when": "false"
				},
				{
					"command": "cloudforge.openArchitectureFocus",
					"when": "false"
				},
				{
					"command": "cloudforge.validateProjectArchitecture",
					"when": "false"
				},
				{
					"command": "cloudforge.planProjectArchitecture",
					"when": "false"
				},
				{
					"command": "cloudforge.revealArchitectureFolder",
					"when": "false"
				},
				{
					"command": "cloudforge.revealRepositoryFolder",
					"when": "false"
				},
				{
					"command": "cloudforge.reattachRepository",
					"when": "false"
				},
				{
					"command": "cloudforge.removeRepository",
					"when": "false"
				},
				{
					"command": "cloudforge.cloneRepositoryAgain",
					"when": "false"
				},
				{
					"command": "cloudforge.switchArchitecture",
					"when": "cloudforge.projectOpen"
				},
				{
					"command": "cloudforge.importRepository",
					"when": "cloudforge.projectOpen"
				},
				{
					"command": "cloudforge.createArchitecture",
					"when": "cloudforge.projectOpen"
				},
				{
					"command": "cloudforge.openProjectGallery",
					"when": "cloudforge.projectOpen"
				},
				{
					"command": "cloudforge.forgetProjectAccess",
					"when": "cloudforge.projectOpen"
				},
				{
					"command": "cloudforge.revealStateResource",
					"when": "false"
				},
				{
					"command": "cloudforge.deleteCloudKey",
					"when": "false"
				},
				{
					"command": "cloudforge.resetIgnoredImports",
					"when": "cloudforge.projectOpen"
				}
			],
			"view/title": [
				{
					"command": "cloudforge.switchArchitecture",
					"when": "view =~ /^cloudforge\\.(panel\\.)?projects$/ && cloudforge.projectOpen",
					"group": "navigation@0"
				},
				{
					"command": "cloudforge.openProjectGallery",
					"when": "view =~ /^cloudforge\\.(panel\\.)?projects$/ && cloudforge.projectOpen",
					"group": "navigation@0"
				},
				{
					"command": "cloudforge.createArchitecture",
					"when": "view =~ /^cloudforge\\.(panel\\.)?projects$/ && cloudforge.projectOpen",
					"group": "navigation@1"
				},
				{
					"command": "cloudforge.openTemplateLibrary",
					"when": "view =~ /^cloudforge\\.(panel\\.)?projects$/",
					"group": "navigation@2"
				},
				{
					"command": "cloudforge.cloneRepository",
					"when": "view =~ /^cloudforge\\.(panel\\.)?projects$/",
					"group": "navigation@3"
				},
				{
					"command": "cloudforge.refreshProject",
					"when": "view =~ /^cloudforge\\.(panel\\.)?projects$/",
					"group": "navigation@4"
				},
				{
					"command": "cloudforge.openProjectInNewWindow",
					"when": "view =~ /^cloudforge\\.(panel\\.)?projects$/",
					"group": "project@0"
				},
				{
					"command": "cloudforge.applyWorkspacePreset",
					"when": "view =~ /^cloudforge\\.(panel\\.)?projects$/",
					"group": "project@1"
				},
				{
					"command": "cloudforge.resetIgnoredImports",
					"when": "view =~ /^cloudforge\\.(panel\\.)?projects$/ && cloudforge.projectOpen",
					"group": "project@2"
				},
				{
					"command": "cloudforge.forgetProjectAccess",
					"when": "view =~ /^cloudforge\\.(panel\\.)?projects$/ && cloudforge.projectOpen",
					"group": "project@3"
				},
				{
					"command": "cloudforge.openCanvas",
					"when": "view =~ /^cloudforge\\.(panel\\.)?resources$/",
					"group": "navigation@1"
				},
				{
					"command": "cloudforge.applyWorkspacePreset",
					"when": "view =~ /^cloudforge\\.(panel\\.)?resources$/",
					"group": "navigation@2"
				},
				{
					"command": "cloudforge.validateArchitecture",
					"when": "view =~ /^cloudforge\\.(panel\\.)?resources$/",
					"group": "navigation@3"
				},
				{
					"command": "cloudforge.runEnginePlan",
					"when": "view =~ /^cloudforge\\.(panel\\.)?resources$/",
					"group": "navigation@4"
				},
				{
					"command": "cloudforge.inspectArchitectureReadiness",
					"when": "view =~ /^cloudforge\\.(panel\\.)?resources$/",
					"group": "1_tools@1"
				},
				{
					"command": "cloudforge.diffProviderSchema",
					"when": "view =~ /^cloudforge\\.(panel\\.)?resources$/",
					"group": "1_tools@2"
				},
				{
					"command": "cloudforge.exportMultiTarget",
					"when": "view =~ /^cloudforge\\.(panel\\.)?resources$/",
					"group": "1_tools@3"
				},
				{
					"command": "cloudforge.openProjectStatus",
					"when": "view == cloudforge.status",
					"group": "navigation@1"
				},
				{
					"command": "cloudforge.refreshSidePanel",
					"when": "view == cloudforge.status || view == cloudforge.state || view == cloudforge.connections",
					"group": "navigation@9"
				},
				{
					"command": "cloudforge.linkCloudConnection",
					"when": "view == cloudforge.connections",
					"group": "navigation@1"
				}
			],
			"view/item/context": [
				{
					"command": "cloudforge.openArchitectureCanvas",
					"when": "view =~ /^cloudforge\\.(panel\\.)?projects$/ && viewItem =~ /^cloudforge\\.architecture\\..*\\.readable$/",
					"group": "inline@1"
				},
				{
					"command": "cloudforge.openArchitectureFocus",
					"when": "view =~ /^cloudforge\\.(panel\\.)?projects$/ && viewItem =~ /^cloudforge\\.architecture\\..*\\.readable$/",
					"group": "inline@2"
				},
				{
					"command": "cloudforge.validateProjectArchitecture",
					"when": "view =~ /^cloudforge\\.(panel\\.)?projects$/ && viewItem =~ /^cloudforge\\.architecture\\..*\\.readable$/",
					"group": "1_actions@1"
				},
				{
					"command": "cloudforge.planProjectArchitecture",
					"when": "view =~ /^cloudforge\\.(panel\\.)?projects$/ && viewItem =~ /^cloudforge\\.architecture\\..*\\.readable$/",
					"group": "1_actions@2"
				},
				{
					"command": "cloudforge.revealArchitectureFolder",
					"when": "view =~ /^cloudforge\\.(panel\\.)?projects$/ && viewItem == cloudforge.architecture.local.readable",
					"group": "1_actions@3"
				},
				{
					"command": "cloudforge.importRepository",
					"when": "view =~ /^cloudforge\\.(panel\\.)?projects$/ && viewItem =~ /^cloudforge\\.repository\\.available/",
					"group": "inline@1"
				},
				{
					"command": "cloudforge.revealRepositoryFolder",
					"when": "view =~ /^cloudforge\\.(panel\\.)?projects$/ && viewItem =~ /^cloudforge\\.repository\\.available/",
					"group": "1_actions@1"
				},
				{
					"command": "cloudforge.reattachRepository",
					"when": "view =~ /^cloudforge\\.(panel\\.)?projects$/ && viewItem =~ /^cloudforge\\.repository\\.notInWorkspace/",
					"group": "inline@1"
				},
				{
					"command": "cloudforge.cloneRepositoryAgain",
					"when": "view =~ /^cloudforge\\.(panel\\.)?projects$/ && viewItem =~ /^cloudforge\\.repository\\.missing\\.remote$/",
					"group": "inline@1"
				},
				{
					"command": "cloudforge.removeRepository",
					"when": "view =~ /^cloudforge\\.(panel\\.)?projects$/ && viewItem =~ /^cloudforge\\.repository\\./",
					"group": "inline@2"
				},
				{
					"command": "cloudforge.importRepository",
					"when": "view =~ /^cloudforge\\.(panel\\.)?projects$/ && viewItem == cloudforge.unimportedFolder",
					"group": "inline@1"
				},
				{
					"command": "cloudforge.linkCloudConnection",
					"when": "view == cloudforge.connections && viewItem =~ /^cloudforge\\.connection\\./",
					"group": "inline@1"
				},
				{
					"command": "cloudforge.checkCloudSignIn",
					"when": "view == cloudforge.connections && viewItem =~ /^cloudforge\\.connection\\.[a-z]+\\.linked/",
					"group": "inline@0"
				},
				{
					"command": "cloudforge.storeCloudKey",
					"when": "view == cloudforge.connections && viewItem =~ /^cloudforge\\.connection\\.(azure|aws)\\.linked/",
					"group": "inline@2"
				},
				{
					"command": "cloudforge.removeCloudConnection",
					"when": "view == cloudforge.connections && viewItem =~ /^cloudforge\\.connection\\.[a-z]+\\.linked/",
					"group": "inline@3"
				},
				{
					"command": "cloudforge.deleteCloudKey",
					"when": "view == cloudforge.connections && viewItem =~ /\\.key$/",
					"group": "key@1"
				},
				{
					"command": "cloudforge.explainResource",
					"when": "view =~ /^cloudforge\\.(panel\\.)?resources$/ && viewItem == cloudForgeResource",
					"group": "inline@1"
				}
			],
			"editor/context": [
				{
					"command": "cloudforge.revealNodeInCanvas",
					"when": "resourceLangId == terraform || resourceLangId == hcl",
					"group": "cloudforge@1"
				},
				{
					"command": "cloudforge.explainResource",
					"when": "resourceLangId == terraform || resourceLangId == hcl",
					"group": "cloudforge@2"
				}
			]
		},
		"viewsContainers": {
			"activitybar": [
				{
					"id": "cloudforge",
					"title": "%viewContainer.cloudforge%",
					"icon": "resources/cloudforge-activity.svg"
				}
			]
		}
	},
	"activationEvents": [
		"onLanguage:terraform",
