{
	"name": "cloudforge",
	"displayName": "%displayName%",
	"description": "%description%",
	"version": "0.0.1",
	"publisher": "cloudforge",
	"license": "MIT",
	"engines": {
		"vscode": "^1.74.0"
	},
	"main": "./dist/extension.js",
	"extensionKind": [
		"ui"
	],
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": true
		},
		"virtualWorkspaces": true
	},
	"contributes": {
		"languages": [
			{
				"id": "terraform",
				"extensions": [
					".tf",
					".tfvars",
					".tofu",
					".tftest.hcl"
				],
				"aliases": [
					"Terraform",
					"OpenTofu",
					"terraform",
					"hcl"
				],
				"configuration": "./terraform.language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "terraform",
				"scopeName": "source.hcl.terraform",
				"path": "./syntaxes/terraform.tmLanguage.json"
			}
		],
		"configuration": {
			"title": "%displayName%",
			"properties": {
				"cloudforge.editor.codeLens": {
					"type": "boolean",
					"default": true,
					"description": "%config.editor.codeLens%"
				},
				"cloudforge.startup.preload": {
					"type": "boolean",
					"default": true,
					"description": "%config.startup.preload%"
				},
				"cloudforge.projects.openInNewWindow": {
					"type": "string",
					"enum": [
						"ask",
						"newWindow",
						"currentWindow"
					],
					"default": "ask",
					"description": "%config.projects.openInNewWindow%"
				}
			}
		},
		"commands": [
			{
				"command": "cloudforge.providers.refresh",
				"title": "%command.providers.refresh%",
				"category": "CloudForge",
				"icon": "$(refresh)"
			},
			{
				"command": "cloudforge.providers.download",
				"title": "%command.providers.download%",
				"category": "CloudForge",
				"icon": "$(cloud-download)"
			},
			{
				"command": "cloudforge.providers.extractSchema",
				"title": "%command.providers.extractSchema%",
				"category": "CloudForge",
				"icon": "$(symbol-structure)"
			},
			{
				"command": "cloudforge.providers.remove",
				"title": "%command.providers.remove%",
				"category": "CloudForge",
				"icon": "$(trash)"
			},
			{
