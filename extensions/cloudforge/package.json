{
	"name": "cloudforge",
	"displayName": "%displayName%",
	"description": "%description%",
	"version": "0.0.1",
	"publisher": "cloudforge",
	"license": "MIT",
	"engines": {
		"vscode": "^1.74.0"
	},
	"main": "./dist/extension.js",
	"extensionKind": [
		"ui"
	],
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": true
		},
		"virtualWorkspaces": true
	},
	"contributes": {
		"commands": [
			{
				"command": "cloudforge.showProofStatus",
				"title": "%command.showProofStatus%",
				"category": "%displayName%"
			},
			{
				"command": "cloudforge.openWorkspace",
				"title": "%command.openWorkspace%",
				"category": "%displayName%"
			},
			{
				"command": "cloudforge.cloneRepository",
				"title": "%command.cloneRepository%",
				"category": "%displayName%",
				"icon": "$(repo-clone)"
			},
			{
				"command": "cloudforge.createProject",
				"title": "%command.createProject%",
				"category": "%displayName%",
				"icon": "$(new-folder)"
			},
			{
				"command": "cloudforge.createArchitecture",
				"title": "%command.createArchitecture%",
				"category": "%displayName%",
				"icon": "$(add)"
			},
			{
				"command": "cloudforge.importRepository",
				"title": "%command.importRepository%",
				"category": "%displayName%",
				"icon": "$(cloud-download)"
			},
			{
				"command": "cloudforge.refreshProject",
				"title": "%command.refreshProject%",
				"category": "%displayName%",
				"icon": "$(refresh)"
			},
			{
				"command": "cloudforge.forgetProjectAccess",
				"title": "%command.forgetProjectAccess%",
				"category": "%displayName%"
			},
			{
				"command": "cloudforge.installGit",
				"title": "%command.installGit%",
				"category": "%displayName%"
			},
			{
				"command": "cloudforge.openArchitecture",
				"title": "%command.openArchitecture%",
				"category": "%displayName%"
			},
			{
				"command": "cloudforge.removeRepository",
				"title": "%command.removeRepository%",
				"category": "%displayName%",
				"icon": "$(close)"
			},
			{
				"command": "cloudforge.cloneRepositoryAgain",
				"title": "%command.cloneRepositoryAgain%",
				"category": "%displayName%",
				"icon": "$(repo-clone)"
			},
			{
				"command": "cloudforge.openCanvas",
				"title": "%command.openCanvas%",
				"category": "%displayName%",
				"icon": "$(type-hierarchy)"
			},
			{
				"command": "cloudforge.toggleCanvasFocusMode",
				"title": "%command.toggleCanvasFocusMode%",
				"category": "%displayName%",
				"icon": "$(screen-full)"
			},
			{
				"command": "cloudforge.validateArchitecture",
				"title": "%command.validateArchitecture%",
				"category": "%displayName%",
				"icon": "$(check-all)"
			},
			{
				"command": "cloudforge.cancelValidation",
				"title": "%command.cancelValidation%",
				"category": "%displayName%",
				"icon": "$(debug-stop)"
			},
			{
				"command": "cloudforge.exportCanvas",
				"title": "%command.exportCanvas%",
				"category": "%displayName%",
				"icon": "$(export)"
			},
			{
				"command": "cloudforge.importProviderSchema",
				"title": "%command.importProviderSchema%",
				"category": "%displayName%",
				"icon": "$(cloud-upload)"
			},
			{
				"command": "cloudforge.openTemplateLibrary",
				"title": "%command.openTemplateLibrary%",
				"category": "%displayName%",
				"icon": "$(library)"
			},
			{
				"command": "cloudforge.openProjectGallery",
				"title": "%command.openProjectGallery%",
				"category": "%displayName%",
				"icon": "$(layout)"
			},
			{
				"command": "cloudforge.openProjectStatus",
				"title": "%command.openProjectStatus%",
				"category": "%displayName%",
				"icon": "$(dashboard)"
			},
			{
				"command": "cloudforge.refreshSidePanel",
				"title": "%command.refreshSidePanel%",
				"category": "%displayName%",
				"icon": "$(refresh)"
			},
			{
				"command": "cloudforge.linkCloudConnection",
				"title": "%command.linkCloudConnection%",
				"category": "%displayName%",
				"icon": "$(plug)"
			},
			{
				"command": "cloudforge.storeCloudKey",
				"title": "%command.storeCloudKey%",
				"category": "%displayName%",
				"icon": "$(key)"
			},
			{
				"command": "cloudforge.deleteCloudKey",
				"title": "%command.deleteCloudKey%",
				"category": "%displayName%",
				"icon": "$(trash)"
			},
			{
				"command": "cloudforge.removeCloudConnection",
				"title": "%command.removeCloudConnection%",
				"category": "%displayName%",
				"icon": "$(debug-disconnect)"
			},
			{
				"command": "cloudforge.revealStateResource",
				"title": "%command.revealStateResource%",
				"category": "%displayName%"
			}
		],
		"keybindings": [
			{
				"command": "cloudforge.toggleCanvasFocusMode",
				"key": "ctrl+alt+f",
				"mac": "cmd+alt+f"
			}
		],
		"views": {
			"explorer": [
				{
					"id": "cloudforge.projects",
					"name": "%view.projects%"
				},
				{
					"id": "cloudforge.resources",
					"name": "%view.resources%"
				}
			],
			"cloudforge": [
				{
					"id": "cloudforge.status",
					"name": "%view.status%",
					"icon": "$(dashboard)"
				},
				{
					"id": "cloudforge.panel.projects",
					"name": "%view.projects%"
				},
				{
					"id": "cloudforge.panel.resources",
					"name": "%view.resources%"
				},
				{
					"id": "cloudforge.state",
					"name": "%view.state%",
					"visibility": "collapsed"
				},
				{
					"id": "cloudforge.connections",
					"name": "%view.connections%"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "cloudforge.resources",
				"contents": "%view.resources.welcome%"
			},
			{
				"view": "cloudforge.panel.resources",
				"contents": "%view.resources.welcome%"
			},
			{
				"view": "cloudforge.projects",
				"contents": "%view.projects.welcome%",
				"when": "!cloudforge.projectOpen"
			},
			{
				"view": "cloudforge.panel.projects",
				"contents": "%view.projects.welcome%",
				"when": "!cloudforge.projectOpen"
			},
			{
				"view": "cloudforge.projects",
				"contents": "%view.projects.emptyProject%",
				"when": "cloudforge.projectOpen"
			},
			{
				"view": "cloudforge.panel.projects",
				"contents": "%view.projects.emptyProject%",
				"when": "cloudforge.projectOpen"
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "cloudforge.openArchitecture",
					"when": "false"
				},
				{
					"command": "cloudforge.removeRepository",
					"when": "false"
				},
				{
					"command": "cloudforge.cloneRepositoryAgain",
					"when": "false"
				},
				{
					"command": "cloudforge.importRepository",
					"when": "cloudforge.projectOpen"
				},
				{
					"command": "cloudforge.createArchitecture",
					"when": "cloudforge.projectOpen"
				},
				{
					"command": "cloudforge.openProjectGallery",
					"when": "cloudforge.projectOpen"
				},
				{
					"command": "cloudforge.forgetProjectAccess",
					"when": "cloudforge.projectOpen"
				},
				{
					"command": "cloudforge.revealStateResource",
					"when": "false"
				},
				{
					"command": "cloudforge.deleteCloudKey",
					"when": "false"
				}
			],
			"view/title": [
				{
					"command": "cloudforge.createArchitecture",
					"when": "view =~ /^cloudforge\\.(panel\\.)?projects$/ && cloudforge.projectOpen",
					"group": "navigation@0"
				},
				{
					"command": "cloudforge.openProjectGallery",
					"when": "view =~ /^cloudforge\\.(panel\\.)?projects$/ && cloudforge.projectOpen",
					"group": "navigation@0"
				},
				{
					"command": "cloudforge.openTemplateLibrary",
					"when": "view =~ /^cloudforge\\.(panel\\.)?projects$/",
					"group": "navigation@1"
				},
				{
					"command": "cloudforge.cloneRepository",
					"when": "view =~ /^cloudforge\\.(panel\\.)?projects$/",
					"group": "navigation@2"
				},
				{
					"command": "cloudforge.refreshProject",
					"when": "view =~ /^cloudforge\\.(panel\\.)?projects$/",
					"group": "navigation@3"
				},
				{
					"command": "cloudforge.forgetProjectAccess",
					"when": "view =~ /^cloudforge\\.(panel\\.)?projects$/ && cloudforge.projectOpen",
					"group": "project@1"
				},
				{
					"command": "cloudforge.openCanvas",
					"when": "view =~ /^cloudforge\\.(panel\\.)?resources$/",
					"group": "navigation@1"
				},
				{
					"command": "cloudforge.validateArchitecture",
					"when": "view =~ /^cloudforge\\.(panel\\.)?resources$/",
					"group": "navigation@2"
				},
				{
					"command": "cloudforge.openProjectStatus",
					"when": "view == cloudforge.status",
					"group": "navigation@1"
				},
				{
					"command": "cloudforge.refreshSidePanel",
					"when": "view == cloudforge.status || view == cloudforge.state || view == cloudforge.connections",
					"group": "navigation@9"
				},
				{
					"command": "cloudforge.linkCloudConnection",
					"when": "view == cloudforge.connections",
					"group": "navigation@1"
				}
			],
			"view/item/context": [
				{
					"command": "cloudforge.cloneRepositoryAgain",
					"when": "view =~ /^cloudforge\\.(panel\\.)?projects$/ && viewItem =~ /^cloudforge\\.repository\\.missing\\.remote$/",
					"group": "inline@1"
				},
				{
					"command": "cloudforge.removeRepository",
					"when": "view =~ /^cloudforge\\.(panel\\.)?projects$/ && viewItem =~ /^cloudforge\\.repository\\./",
					"group": "inline@2"
				},
				{
					"command": "cloudforge.importRepository",
					"when": "view =~ /^cloudforge\\.(panel\\.)?projects$/ && viewItem == cloudforge.unimportedFolder",
					"group": "inline@1"
				},
				{
					"command": "cloudforge.linkCloudConnection",
					"when": "view == cloudforge.connections && viewItem =~ /^cloudforge\\.connection\\./",
					"group": "inline@1"
				},
				{
					"command": "cloudforge.storeCloudKey",
					"when": "view == cloudforge.connections && viewItem =~ /^cloudforge\\.connection\\.(azure|aws)\\.linked/",
					"group": "inline@2"
				},
				{
					"command": "cloudforge.removeCloudConnection",
					"when": "view == cloudforge.connections && viewItem =~ /^cloudforge\\.connection\\.[a-z]+\\.linked/",
					"group": "inline@3"
				},
				{
					"command": "cloudforge.deleteCloudKey",
					"when": "view == cloudforge.connections && viewItem =~ /\\.key$/",
					"group": "key@1"
				}
			]
		},
		"viewsContainers": {
			"activitybar": [
				{
					"id": "cloudforge",
					"title": "%viewContainer.cloudforge%",
					"icon": "resources/cloudforge-activity.svg"
				}
			]
		}
	},
	"activationEvents": [
		"workspaceContains:cloudforge.project.json",
		"workspaceContains:*.tf",
		"workspaceContains:*.tf.json"
	]
}
